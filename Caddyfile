# الإعداد الافتراضي: خدمة على HTTP بالـIP مباشرة (بدون دومين).
#
# إذا عندك دومين، بدّل السطر الأول لاسم الدومين:
#     game.example.com {
# وCaddy راح يجيب شهادة SSL تلقائياً من Let's Encrypt.
# (سكربت deploy/setup-vps.sh يسوي هذا التبديل لحاله إذا مررت له دومين)

:80 {
	encode zstd gzip

	# Caddy يمرر ترقية WebSocket تلقائياً، ما يحتاج إعداد إضافي
	reverse_proxy app:3000
}
